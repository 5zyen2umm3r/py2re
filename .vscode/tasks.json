{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "makemigrations",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "manage.py",
                "makemigrations"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "problemMatcher": []
        },
        {
            "label": "migrate",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "manage.py",
                "migrate"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\backend"
            },
            "dependsOn": [
                "makemigrations"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "npm",
            "script": "build",
            "path": "frontend",
            "group": "build",
            "problemMatcher": [],
            "label": "npm: build - frontend",
            "detail": "tsc && vite build"
        },
        {
            "label": "npm-run-dev",
            "type": "npm",
            "script": "dev",
            "detail": "Start development server",
            "path": "frontend",
            "group": "test",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": ".*Local:.*"
                    }
                }
            ]
        },
        {
            "label": "npm-kill-frontend",
            "type": "shell",
            "command": "npx kill-port 5173",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            }
        },
        {
            "type": "npm",
            "script": "install",
            "path": "frontend",
            "group": "build",
            "problemMatcher": [],
            "label": "npm: install",
        },
        {
            "label": "format config.json",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/backend/format_json.py", 
                "${workspaceFolder}/backend/flowpt_cache/config.json",
                "3"
            ]
        }
    ]
}